# Copy to /etc/resonant-lab.env with mode 600. Generate secrets using scripts/rotate_api_key.py.
RESONANT_DB_PATH=/var/lib/resonant/users.db
RESONANT_LAB_API_KEY=GENERATED_PRIVATELY_BY_ROTATION_SCRIPT
RESONANT_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
RESONANT_HOST=127.0.0.1
RESONANT_PORT=8000
RESONANT_CONCURRENCY=1
RESONANT_JOB_TIMEOUT=600
RESONANT_MAX_JOBS=6
RESONANT_QUEUE_TTL_SECONDS=86400
RESONANT_JOB_RETENTION_SECONDS=604800
# Leave default SQLite journal mode unless WAL has been evaluated on local disk.
RESONANT_SQLITE_WAL=0

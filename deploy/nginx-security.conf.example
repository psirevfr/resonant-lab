# client_body_timeout 30s;
# client_header_timeout 15s;
# limit_req_status 429;
# server_tokens off;
#
# Merge these into existing locations, keeping all proxy headers (especially
# Host, X-Forwarded-For, X-Forwarded-Proto) and any maintenance guard.

# REVIEW AND MERGE; do not include this whole example inside a server block.
# http context, once only. Keep existing ACME/TLS/proxy configuration.
limit_req_zone $binary_remote_addr zone=resonant_auth:1m rate=10r/m;
limit_req_zone $binary_remote_addr zone=resonant_api:1m rate=60r/m;

# Add inside the EXISTING HTTPS server {} block:
